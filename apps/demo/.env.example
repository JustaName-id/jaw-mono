# JAW API key (create one at https://dashboard.jaw.id/)
NEXT_PUBLIC_API_KEY=your-api-key-here
# keys.jaw.id URL (explicit override; defaults to production when unset).
# Local dev points at the local keys app. On Vercel preview deployments, leave
# this unset so the demo auto-targets this PR's own keys preview.
NEXT_PUBLIC_KEYS_URL=http://localhost:3000
