# JAW API key (create one at https://dashboard.jaw.id/)
NEXT_PUBLIC_API_KEY=your-api-key-here
# keys.jaw.id URL (explicit override; defaults to production when unset).
# Local dev points at the local keys app. On Vercel preview deployments, leave
# this unset so the demo auto-targets this PR's own keys preview.
NEXT_PUBLIC_KEYS_URL=http://localhost:3000

# Server-only: treasury key for /api/fund (tops fresh demo accounts up with
# testnet USDC). Never NEXT_PUBLIC_. Funding is disabled when unset.
TREASURY_PRIVATE_KEY=0xyour-treasury-private-key
# Optional RPC overrides for /api/fund. Unset, the route uses the JAW RPC
# proxy authenticated with NEXT_PUBLIC_API_KEY (same endpoint as the SDK).
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL_FALLBACK=
